<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>إدارة أجهزة البلايستيشن</title>
    <style>
        body { font-family: sans-serif; background-color: #1a1a24; color: #fff; padding: 20px; }
        .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; }
        .card { background: #2a2a38; border-radius: 12px; padding: 20px; text-align: center; border: 1px solid #3b3b4f; }
        .device-name { font-size: 1.5rem; font-weight: bold; color: #00d2d3; margin-bottom: 10px; }
        .timer-display { font-size: 2rem; font-family: monospace; margin: 15px 0; color: #ff9f43; }
        .btn { padding: 10px 18px; border: none; border-radius: 6px; cursor: pointer; font-weight: bold; margin: 5px; }
        .btn-start { background-color: #10ac84; color: white; }
        .btn-stop { background-color: #ee5253; color: white; }
        .btn-reset { background-color: #576574; color: white; }
    </style>
</head>
<body>

    <h2>🎮 إدارة أجهزة صالة البلايستيشن</h2>
    <div class="grid" id="devices-container"></div>

    <script>
        const devices = ["eljoker", "salah", "cres", "messi", "pubg (R)", "pubg L"];
        const container = document.getElementById('devices-container');

        devices.forEach((device, index) => {
            container.innerHTML += `
                <div class="card">
                    <div class="device-name">${device}</div>
                    <div class="timer-display" id="timer-${index}">00:00:00</div>
                    <button class="btn btn-start" onclick="startTimer(${index})">بدء الجلسة</button>
                    <button class="btn btn-stop" onclick="stopTimer(${index})">إيقاف / إنهاء</button>
                    <button class="btn btn-reset" onclick="resetTimer(${index})">تصفير</button>
                </div>
            `;
        });

        let timers = {};
        let intervals = {};

        function startTimer(id) {
            if (intervals[id]) return;
            timers[id] = timers[id] || 0;
            intervals[id] = setInterval(() => {
                timers[id]++;
                let hrs = String(Math.floor(timers[id] / 3600)).padStart(2, '0');
                let mins = String(Math.floor((timers[id] % 3600) / 60)).padStart(2, '0');
                let secs = String(timers[id] % 60).padStart(2, '0');
                document.getElementById(`timer-${id}`).innerText = `${hrs}:${mins}:${secs}`;
            }, 1000);
        }

        function stopTimer(id) {
            clearInterval(intervals[id]);
            intervals[id] = null;
        }

        function resetTimer(id) {
            stopTimer(id);
            timers[id] = 0;
            document.getElementById(`timer-${id}`).innerText = "00:00:00";
        }
    </script>
</body>
</html>
